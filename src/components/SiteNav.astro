---
import type { NavItem, NavLink } from '../site';

interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

const linkClass = (link: NavLink) => [link.highlight && 'highlight', link.href === currentPath && 'active'].filter(Boolean).join(' ') || undefined;
---
<nav class="site-nav" aria-label="Main" data-site-nav>
  <!-- The theme toggle's pressed state and label are set by the script below, once it knows the theme -->
  <button type="button" class="theme-toggle" aria-label="Dark theme" title="Switch to the dark theme" data-theme-toggle>
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>
  <button type="button" class="nav-toggle" aria-label="Menu" aria-controls="nav-links" aria-expanded="false" data-menu-toggle>&#9776;</button>
  <ul id="nav-links" class="nav-links">
    {items.map((item) => {
      if (!('items' in item)) {
        return (
          <li>
            <a href={item.href} class={linkClass(item)} aria-current={item.href === currentPath ? 'page' : undefined}>{item.name}</a>
          </li>
        );
      }
      const menuId = `nav-${item.name.toLowerCase()}`;
      return (
        <li class="dropdown" data-dropdown>
          <button
            type="button"
            class={item.items.some((link) => link.href === currentPath) ? 'dropdown-toggle active' : 'dropdown-toggle'}
            aria-controls={menuId}
            aria-expanded="false"
          >
            {item.name}
          </button>
          <ul id={menuId} class="dropdown-menu">
            {item.items.map((link) => (
              <li>
                <a href={link.href} class={linkClass(link)} aria-current={link.href === currentPath ? 'page' : undefined}>{link.name}</a>
              </li>
            ))}
          </ul>
        </li>
      );
    })}
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');

  if (nav) {
    /** Sets `open` on an element and mirrors it in the aria-expanded of the button that controls it */
    const setOpen = (element: HTMLElement, button: HTMLElement, open: boolean) => {
      element.classList.toggle('open', open);
      button.setAttribute('aria-expanded', String(open));
    };

    // Menu button, for narrow screens
    const menuToggle = nav.querySelector<HTMLElement>('[data-menu-toggle]')!;
    menuToggle.addEventListener('click', () => setOpen(nav, menuToggle, !nav.classList.contains('open')));

    // At most one dropdown is open at a time
    const dropdowns = [...nav.querySelectorAll<HTMLElement>('[data-dropdown]')].map((element) => ({
      element,
      button: element.querySelector<HTMLElement>('.dropdown-toggle')!,
    }));
    const closeDropdowns = (except?: HTMLElement) => {
      for (const { element, button } of dropdowns) if (element !== except) setOpen(element, button, false);
    };
    for (const { element, button } of dropdowns) {
      button.addEventListener('click', () => {
        const open = !element.classList.contains('open');
        closeDropdowns(element);
        setOpen(element, button, open);
      });
    }

    // Close the dropdown on a click outside the nav or on Escape
    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) closeDropdowns();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDropdowns();
    });

    // Light/dark switch. The pick is saved; picking the device's own theme goes back to following the device.
    type Theme = 'light' | 'dark';
    const media = matchMedia('(prefers-color-scheme: dark)');
    const root = document.documentElement;
    const systemTheme = (): Theme => (media.matches ? 'dark' : 'light');
    const currentTheme = (): Theme => (root.dataset.theme as Theme | undefined) ?? systemTheme();

    const themeToggle = nav.querySelector<HTMLElement>('[data-theme-toggle]')!;
    const showTheme = () => {
      const dark = currentTheme() === 'dark';
      themeToggle.setAttribute('aria-pressed', String(dark));
      themeToggle.title = dark ? 'Switch to the light theme' : 'Switch to the dark theme';
    };
    showTheme();
    media.addEventListener('change', showTheme);

    themeToggle.addEventListener('click', () => {
      const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
      const followDevice = next === systemTheme();
      if (followDevice) delete root.dataset.theme;
      else root.dataset.theme = next;
      try {
        if (followDevice) localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {
        // Storage can be blocked; the switch still works for this page
      }
      showTheme();
    });
  }
</script>
