---
import PageLayout from '../../layouts/PageLayout.astro';
import PostList from '../../components/PostList.astro';
import { BLOGS, type Blog } from '../../blogs';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
  return BLOGS.map((blog) => ({ params: { blog: blog.slug }, props: { blog } }));
}

const { blog } = Astro.props as { blog: Blog };
const posts = await getPosts(blog.id);
---
<!-- A blog with no posts yet is a nearly empty page; it stays out of search results (and the sitemap) until it has one -->
<PageLayout title={blog.title} descriptionHtml={blog.description} noindex={posts.length === 0}>
  <div class="blog-index">
    <PostList posts={posts} />
  </div>
</PageLayout>
