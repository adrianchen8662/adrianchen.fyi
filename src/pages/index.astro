---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import Typewriter from '../components/Typewriter';
---
<BaseLayout description="Software Engineer at ASRC Federal and Computer Science master's student at NJIT">
  <section class="hero">
    <Typewriter
      client:load
      prefix="Hi, I'm Adrian Chen. I'm"
      phrases={[
        'a Software Engineer.',
        'a Hiker.',
        'a Tinkerer.',
        'an Open-Source Fan.',
        'an Outdoorsman.',
        'a Boilermaker.',
        'a New Jerseyan.',
        'a Runner.',
      ]}
    />
    <a class="button button-light" href="/resume/">Resume</a>
  </section>

  <section id="timeline" class="timeline-section" aria-labelledby="timeline-heading">
    <div class="container">
      <h2 id="timeline-heading" class="section-title">Timeline</h2>
      <Timeline />
    </div>
  </section>
</BaseLayout>
