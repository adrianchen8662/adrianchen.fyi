---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { GA_MEASUREMENT_ID, NAV, SITE } from '../site';

interface Props {
  /** Page name; the home page leaves it out */
  title?: string;
  description?: string;
  /** Open Graph type; articles say so, everything else is a website */
  ogType?: 'website' | 'article';
  /** Structured data for search engines (schema.org), written as JSON-LD */
  jsonLd?: Record<string, unknown>;
  /** Asks search engines to leave the page out of their results */
  noindex?: boolean;
}

const { title, description = SITE.description, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const analyticsHost = Astro.site?.hostname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}'s blog posts`} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {GA_MEASUREMENT_ID && analyticsHost && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, gaHost: analyticsHost }}>
        // Google tag. It only runs on the site's own address, so previews, workers.dev and local runs don't count.
        // The tag itself is large (about 180 kB), so it's fetched once the visitor first interacts, or after
        // 10 seconds, instead of competing with the page for the main thread while it loads. What the page does
        // before then is queued in dataLayer and sent when the tag arrives, so a visit that interacts or stays
        // is counted in full; one that leaves sooner without touching the page isn't.
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        if (location.hostname === gaHost) {
          gtag('js', new Date());
          gtag('config', gaId);
          const events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
          const load = () => {
            events.forEach((event) => removeEventListener(event, load));
            clearTimeout(timer);
            const script = document.createElement('script');
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
            document.head.append(script);
          };
          const timer = setTimeout(load, 10000);
          events.forEach((event) => addEventListener(event, load, { passive: true }));
        }
      </script>
    )}
    <script is:inline>
      // Apply a theme picked with the header switch before the page paints
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href="/">{SITE.name}</a>
        <SiteNav items={NAV} currentPath={Astro.url.pathname} />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
